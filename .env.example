# =================================================================
# ⚙️ CUENTAS STREAM COLOMBIA - TEMPLATE DE CONFIGURACIÓN (.env.example)
# =================================================================

# URL Base de la API REST del Servidor Backend
VITE_API_BASE_URL=https://api.cuentasstream.com/api/v1

# Timeout de las Peticiones HTTP en Milisegundos
VITE_API_TIMEOUT_MS=10000

# Usar Mock Data Local (true/false)
VITE_ENABLE_MOCK_DATA=true

# Teléfono Oficial de WhatsApp (con código de país)
VITE_WHATSAPP_NUMBER=573214465418

# Datos de Cuentas Financieras
VITE_NEQUI_NUMBER=3214465418
VITE_BANCOLOMBIA_NUMBER=03214465418
VITE_DAVIPLATA_NUMBER=3214465418

# Nombre de la Aplicación
VITE_APP_TITLE="Cuentas Stream Colombia"
VITE_APP_ENV=production
