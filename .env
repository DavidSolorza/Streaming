# URL Base de la API REST del Servidor Backend (Alimentador de Datos)
VITE_API_BASE_URL=https://api.cuentasstream.com/api/v1

# Timeout de las Peticiones HTTP en Milisegundos
VITE_API_TIMEOUT_MS=10000

# Bandera para usar Datos de Prueba Locales (true = Mock Local, false = Servidor API Real)
VITE_ENABLE_MOCK_DATA=true

# 🎬 TMDb API (The Movie Database) para Estrenos y Carteleras
VITE_TMDB_API_KEY=c4b8fa671dd3a68297b80a13ebec05b2
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500

# 📱 Teléfono Oficial de WhatsApp para Recepción de Pedidos y Soporte
VITE_WHATSAPP_NUMBER=573214465418

# 💳 Datos de Cuentas Financieras Oficiales para Transferencias en Colombia
VITE_NEQUI_NUMBER=3214465418
VITE_BANCOLOMBIA_NUMBER=03214465418
VITE_DAVIPLATA_NUMBER=3214465418

# 🏷️ Nombre e Identificación de la Aplicación
VITE_APP_TITLE="Cuentas Stream Colombia"
